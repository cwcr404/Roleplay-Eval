  "why_natural": "同为官方出产，但语域是战斗/宣言，与陪聊场景天然错位——是最好的'已知异物'",
  "items": [
    {"id": "NEG-KILL-01", "text": "万恶，皆斩！", "type": "必杀喊招", "note": "极端短句，对照锚点温柔长句"},
    {"id": "NEG-KILL-02", "text": "千刃，一心！", "type": "必杀喊招"},
    {"id": "NEG-KILL-03", "text": "刀影，浮沉随心！", "type": "必杀前段"},
    {"id": "NEG-KILL-04", "text": "雷光，于此显现！", "type": "必杀前段"},
    {"id": "NEG-KILL-05", "text": "隐没吧。", "type": "必杀后段"},
    {"id": "NEG-KILL-06", "text": "止息吧。", "type": "必杀后段"},
    {"id": "NEG-KILL-07", "text": "破绽百出！", "type": "必杀"},
    {"id": "NEG-KILL-08", "text": "兵不厌诈！", "type": "必杀"},
    {"id": "NEG-KILL-09", "text": "风刃！", "type": "必杀第一击"},
    {"id": "NEG-KILL-10", "text": "疾雷！", "type": "必杀第一击"},
    {"id": "NEG-KILL-11", "text": "断！", "type": "必杀第二击"},
    {"id": "NEG-KILL-12", "text": "破！", "type": "必杀第二击"},
    {"id": "NEG-KILL-13", "text": "怒吼吧！俱利伽罗！", "type": "必杀（雷律期，旁证）"},
    {"id": "NEG-BATTLE-01", "text": "就是现在！", "type": "战斗播报"},
    {"id": "NEG-BATTLE-02", "text": "轮到我了！", "type": "战斗播报"},
    {"id": "NEG-BATTLE-03", "text": "我已就位。", "type": "战斗播报"},
    {"id": "NEG-BATTLE-04", "text": "跟紧些。", "type": "战斗指令"},
    {"id": "NEG-BATTLE-05", "text": "目标就在前方。", "type": "战斗播报"},
    {"id": "NEG-RATE-01", "text": "不堪一击。", "type": "对手评级腔", "note": "极端短句+评判味，与温柔长句形成对照"},
    {"id": "NEG-RATE-02", "text": "不过如此。", "type": "对手评级腔"},
    {"id": "NEG-RATE-03", "text": "不能大意。", "type": "战斗自我提示"},
    {"id": "NEG-RATE-04", "text": "绝不能手下留情。", "type": "战斗自我提示"},
    {"id": "NEG-RATE-05", "text": "马上解决！", "type": "战斗播报"}
  ]
}
