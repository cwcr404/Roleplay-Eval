# 依赖 / 环境
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 密钥 —— 绝不进 git
.env
*.local

# 输出产物(报告可选择性提交,先全忽略)
output/
*.tmp

# 系统文件
.DS_Store
Thumbs.db

# 运行时账本 / 记忆链数据（合规红线：记忆数据一个字节不进 git）
data/memory/
data/memory/**

# 自检/验收脚本生成的报告产物（非源码,随跑随变）
session/selfcheck_report.txt
output/**

# 内部草稿（不进公开库）
docs/_why_section_draft.md
docs/_arch_section_draft.md
docs/_security_audit_*.md
docs/_gif_parked_*.md
docs/_tag_commit_msg_draft.md
_*.txt

# 运行时记忆数据(合规红线:记忆数据一个字节不进 git)
# 关键:不用裸 'memory/' —— 它匹配任意层级,会误伤源码包 kb/memory/。
# 按位置锚定:'/memory/' 只匹配仓库根的 memory/,不碰 kb/memory/。
data/memory/
/memory/
kb/memory/__pycache__/

# 本地私用(求职/JD 留档,不进公开库)
docs/_jd_archive.md
_audit_tmp.py
# 一次性分析脚本(产物已入库,脚本复现价值低,不进公开库)
dev/_*.py
# 观测台起服务的运行日志(随跑随变)
obs*.log
session/obs*.log
# 内部备忘(分支管理/临时事项)
dev/NOTES.md
