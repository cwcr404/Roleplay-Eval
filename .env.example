# Roleplay-Eval 环境变量示例
#
# 使用方法:
#   cp .env.example .env
#   然后在 .env 里填入你自己的密钥(.env 已被 .gitignore 忽略,不会进 git)

# ---- 必填 ----
# DeepSeek API 密钥(被测 Agent 与 Judge 都走这条出口)
# 获取: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# ---- 选填(留空则用默认值) ----
# 模型名,默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 知识库检索模式,默认 plain(标签查表);向量模式尚为占位契约
KB_MODE=plain

# 记忆账本根目录(真实多轮会话的 L1/L2 数据落在这里)
# 不设置时 kb/memory/ledger.py 使用包内默认路径。
# 该目录含对话隐私数据,已被 .gitignore 忽略,首次运行会自动创建。
# KB_DATA_ROOT=./data/memory

# 真实多轮会话默认 user_id(仅 chat_session.py 使用)
AYAME_USER_ID=u_demo
